# Copy to .env (or export in your shell) and fill in.
# Pick a provider. Auto-detect: OpenAI if OPENAI_API_KEY set, else Anthropic if
# ANTHROPIC_API_KEY set, else local Ollama (free, no key). Or force LLM_PROVIDER.

# --- Option A: local Ollama (free, runs on your machine) ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Option B: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Option C: Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# For the LinkedIn / Apify source (--source apify):
# APIFY_API_TOKEN=apify_api_...
# APIFY_ACTOR=bebity~linkedin-jobs-scraper
