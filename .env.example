# Copy to .env (or export in your shell) and fill in.
# Pick ONE provider. If OPENAI_API_KEY is set, OpenAI is used automatically.

# --- Option A: OpenAI ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Option B: Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# Force a provider explicitly (optional): openai | anthropic
# LLM_PROVIDER=openai

# For the LinkedIn / Apify source (--source apify):
# APIFY_API_TOKEN=apify_api_...
# APIFY_ACTOR=bebity~linkedin-jobs-scraper
